module Onboardable
  VERSION: String

  def self.included: (Module klass) -> void

  module ClassMethods
    attr_accessor list_builder: List::Builder

    def onboarding=: (?Hash[Symbol, untyped] options) { (List::Builder) [self: List::Builder] -> untyped } -> untyped

    alias has_onboarding onboarding=

    def onboarding: (?String? current_step_name) -> List::Base
  end

  interface _OnboardableClass
    def class: () -> ClassMethods
  end

  module InstanceMethods : _OnboardableClass
    def onboarding: (?String? current_step_name) -> List::Base
  end
end
